NEXT_PUBLIC_BASE_URL=https://calculator.payapress.com

# ── Google Sign-In (Google Identity Services) ────────────────────────────────
# The OAuth CLIENT ID is public by design (it ships in the JS bundle of every
# site that uses Google Sign-In) — safe to commit. It must be present at BUILD
# time because NEXT_PUBLIC_* values are inlined into the client bundle.
# The client SECRET is NOT used by this flow (we verify the ID token against
# Google's public JWKS) and must never be committed anywhere.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=865063517296-8aaboes5fum8ltrb9mrq8rfm1irmicv4.apps.googleusercontent.com

# ── Hostinger SMTP ────────────────────────────────────────────────────────────
# Fill in SMTP_USER and SMTP_PASS with the email account created in Hostinger.
# Example: noreply@calculator.payapress.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
