11:["$","section",null,{"style":"$a:props:children:0:props:children:1:props:children:props:children:2:props:style","children":[["$","h2",null,{"style":"$a:props:children:0:props:children:1:props:children:props:children:2:props:children:0:props:style","children":"3. Solution"}],["$","p",null,{"style":"$a:props:children:0:props:children:1:props:children:props:children:2:props:children:1:props:style","children":"The PAYAPRESS platform addresses these pain points with a web-native application requiring no installation. As a PWA, it installs to the home screen on Android and iOS and continues to function offline via a service worker cache. The architecture is deliberately simple: all calculation logic runs client-side, no user data is ever transmitted, and the server acts only as a secure proxy for live copper price and FX rate feeds."}],["$","p",null,{"style":"$a:props:children:0:props:children:1:props:children:props:children:2:props:children:1:props:style","children":"The platform is designed to grow modularly — each phase adds a self-contained feature set without disrupting existing tools. All features target the specific needs of electrical panel fabricators in the UAE and the MENA region, with full support for Persian (فارسی) and Arabic (العربية) content planned for later phases."}]]}]
