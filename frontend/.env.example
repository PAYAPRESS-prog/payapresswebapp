# ── WordPress Integration ──────────────────────────────────────────
# URL of your WordPress site (used for CORS and image domains)
NEXT_PUBLIC_WP_URL=https://your-wordpress-site.com
NEXT_PUBLIC_WP_HOSTNAME=your-wordpress-site.com

# WordPress REST API base (proxied through /api/wp/*)
NEXT_PUBLIC_WP_API_BASE=https://your-wordpress-site.com/wp-json/wp/v2

# ── Security ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
PAYAPRESS_SECRET_KEY=change-me-to-a-secure-random-string

# ── Calculator / Pricing ───────────────────────────────────────────
# Copper price data: fetched from COMEX (Yahoo Finance HG=F), no API key needed.
# FX rates: fetched from open.er-api.com, no API key needed.
# Both are cached server-side (copper: 5 min, FX: 1 hour).
