# ── Site URL (required for production) ────────────────────────────
# Set this to your production URL in the Vercel dashboard (Environment Variables)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# ── WordPress Integration (optional) ──────────────────────────────
# Only needed if using the WordPress companion plugin / embed route.
NEXT_PUBLIC_WP_URL=https://your-wordpress-site.com
NEXT_PUBLIC_WP_HOSTNAME=your-wordpress-site.com
NEXT_PUBLIC_WP_API_BASE=https://your-wordpress-site.com/wp-json/wp/v2

# ── Notes ──────────────────────────────────────────────────────────
# Copper price → COMEX HG=F via Yahoo Finance (no API key needed)
# FX rates     → Frankfurter / ECB (no API key needed)
# Both cached server-side via Next.js ISR (copper: 5 min, FX: 6 hr)
