{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Busbar Calculator",
  "version": "1.0.2",
  "identifier": "com.payapress.busbar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Busbar Calculator \u2014 Payapress",
    "shortDescription": "Copper & aluminum busbar cost calculator with live prices",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "busbar"
        ]
      }
    }
  }
}